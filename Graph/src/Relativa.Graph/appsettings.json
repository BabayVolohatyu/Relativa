{
  "Urls": "http://*:8083",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=relativa;Username=relativa;Password=relativa"
  },
  "RabbitMqGraph": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "DomainExchange": "relativa.domain",
    "WorkspaceBindingRoutingKeyPattern": "core.workspace.*",
    "WorkspaceQueueName": "domain.events.graph.workspace.v1",
    "DeadLetterFanoutExchange": "relativa.consumer.graph.workspace.v1.dlx",
    "DeadLetterQueueName": "domain.events.graph.workspace.v1.failed"
  },
  "MlApi": {
    "BaseUrl": "http://localhost:8084"
  },
  "MlScoringResilience": {
    "Enabled": true,
    "MaxAttempts": 3,
    "PerAttemptTimeoutMs": 200,
    "BaseDelayMs": 50,
    "MaxDelayMs": 400,
    "UnprotectedTimeoutMs": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
